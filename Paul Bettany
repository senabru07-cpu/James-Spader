#include <Servo.h>

Servo myservo; 
const int CarbuttonPin = 2;
const int SokoviabuttonPin = 4;

void setup() {
  // put your setup code here, to run once:
  Serial.begin(9600);
  myservo.attach(9);
  pinMode(CarbuttonPin, INPUT);
  myservo.attach(10);
  pinMode(SokoviabuttonPin, INPUT);

}

void loop() {
  // put your main code here, to run repeatedly:
  if (digitalRead(CarbuttonPin) == HIGH){
    myservo.write(180);

  } else {
    myservo.write(0);
  }

  if (digitalRead(SokoviabuttonPin) == LOW){
    myservo.write(90);
    Serial.println("glibby");
  } else {
    myservo.write(-180);
    Serial.println("Gloobs");
  }
}

